<Window x:Class="Excercise3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Excercise3"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Height="550" Width="850"
        ResizeMode="NoResize"
        Background="Transparent"      
        MouseDown="Window_MouseDown"
        WindowStyle="None">
    <Border CornerRadius="50" BorderThickness="5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0FF0FC" Offset="0"/>
                <GradientStop Color="#3A0CA3" Offset="0.75"/>
                <GradientStop Color="#7209B7" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#060531"/>
                <GradientStop Color="#1B1448" Offset="0.75"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PANMIN" FontSize="10" 
                           Foreground="DarkGray" 
                           Grid.Column="0" 
                           Margin="35,0,0,0" 
                           VerticalAlignment="Center"/>
                <Button x:Name="btnMinisize" 
                        Grid.Column="1" 
                        BorderThickness="0"
                        Content="-"
                        Foreground="White"
                        FontSize="16"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Background="#28AEED" Click="btnMinisize_Click">
                </Button>
                <Button x:Name="btnClose" 
                        Grid.Column="2" 
                        BorderThickness="0"
                        Content="X"
                        Foreground="White"
                        FontSize="16"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Background="#DA34AE" Click="btnClose_Click">
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,35,0,0" Width="250">
                <TextBlock Text="Exercise 3"
                            Foreground = "White"
                            FontSize="25"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Binding"
                            Foreground = "White"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Nhập vào đây"
                            Foreground = "DarkGray"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,35,0,0"/>
                <TextBox x:Name="txtInput"
                         FontSize="13"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         FontWeight="Medium"
                         FontFamily="Montserrat"
                         Foreground="White"
                         CaretBrush = "LightGray"
                         BorderBrush="DarkGray"
                         BorderThickness="0,0,0,1"
                         Height="28"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="0,5,0,0"
                         Padding="20,0,0,0">
                </TextBox>
                <TextBlock Text="Hiện ra ở dưới"
                            Foreground = "DarkGray"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,35,0,0"/>
                <TextBlock x:Name="txtOutput"
                         FontSize="13"
                         Text="{Binding Name}"
                         Background="Transparent"
                         FontWeight="Medium"
                         FontFamily="Montserrat"
                         Foreground="White"
                         Height="28"
                         Margin="0,5,0,30"
                         Padding="20,0,0,0">
                </TextBlock>
                <Border CornerRadius="10" Background="#DA34AE" Width="100">
                    <Button x:Name="btnClick"
                            BorderThickness="0"
                            Content="Lấy dữ liệu UI"
                            Height="25"
                            FontFamily="Montserrat"
                            Cursor="Hand"
                            Background="Transparent"
                            Grid.Column="2" Click="btnClick_Click"> 
                    </Button>
                </Border>


            </StackPanel>

        </Grid>

    </Border>


</Window>