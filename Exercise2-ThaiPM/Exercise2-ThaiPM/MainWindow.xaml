<Window x:Class="Exercise2_ThaiPM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercise2_ThaiPM"
        mc:Ignorable="d"
        Title="Excercise2" Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"      
        MouseDown="Window_MouseDown"
        WindowStyle="None">
    <Border CornerRadius="50" BorderThickness="5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0FF0FC" Offset="0"/>
                <GradientStop Color="#3A0CA3" Offset="0.75"/>
                <GradientStop Color="#7209B7" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#060531"/>
                <GradientStop Color="#1B1448" Offset="0.75"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="LOGIN" FontSize="10" 
                           Foreground="DarkGray" 
                           Grid.Column="0" 
                           Margin="35,0,0,0" 
                           VerticalAlignment="Center"/>
                <Button x:Name="btnMinisize" 
                        Grid.Column="1" 
                        BorderThickness="0"
                        Content="-"
                        Foreground="White"
                        FontSize="16"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Background="#28AEED" Click="btnMinisize_Click">
                </Button>
                <Button x:Name="btnClose" 
                        Grid.Column="2" 
                        BorderThickness="0"
                        Content="X"
                        Foreground="White"
                        FontSize="16"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Background="#DA34AE" Click="btnClose_Click">
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,35,0,0" Width="250">
                <TextBlock Text="Newwave Solutions"
                            Foreground = "White"
                            FontSize="25"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Together with your challenges"
                            Foreground = "White"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Center"/>
                <TextBlock Text="Username"
                            Foreground = "DarkGray"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,35,0,0"/>
                <TextBox x:Name="txtUser"
                         FontSize="13"
                         FontWeight="Medium"
                         FontFamily="Montserrat"
                         Foreground="White"
                         CaretBrush = "LightGray"
                         BorderBrush="DarkGray"
                         BorderThickness="0,0,0,1"
                         Height="28"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="0,5,0,0"
                         Padding="20,0,0,0">
                </TextBox>
                <TextBlock Text="Username"
                            Foreground = "DarkGray"
                            FontSize="12"
                            FontWeight="Medium"
                            FontFamily="Montserrat"
                            Margin="0,35,0,0"/>
                <PasswordBox x:Name="txtPassword"
                         FontSize="13"
                         Background="Transparent"
                         FontWeight="Medium"
                         FontFamily="Montserrat"
                         Foreground="White"
                         CaretBrush = "LightGray"
                         BorderBrush="DarkGray"
                         BorderThickness="0,0,0,1"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Margin="0,5,0,30"
                         Padding="20,0,0,0">                
                </PasswordBox>

                <Border CornerRadius="10" Background="#DA34AE" Width="100">
                    <Button x:Name="btnLogin"
                            BorderThickness="0"
                            Content="Login"
                            Height="25"
                            FontFamily="Montserrat"
                            Cursor="Hand"
                            Background="Transparent"
                            Grid.Column="2" Click="btnLogin_Click">
                    </Button>
                </Border>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0">
                        <TextBlock x:Name="txtForgotPassword"
                                    Text="Forgot Password?"
                                    Foreground = "DarkGray"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    FontFamily="Montserrat"
                                    MouseDown="ForgotPassword_MouseDown"/>

                        <TextBlock x:Name="txtReset"
                                    Text="Reset"
                                    MouseDown="Reset_MouseDown"
                                    Foreground = "White"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    FontFamily="Montserrat"
                                    Cursor="Hand"
                                    Margin="10,0,0,0"/>

                </StackPanel>
            </StackPanel>
            
        </Grid>
        
    </Border>


</Window>
