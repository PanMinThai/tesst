<UserControl x:Class="TodoList_PhanMinhThai.Views.TaskItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TodoList_PhanMinhThai.Views"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="580"
             Background="Transparent">
    <Border Background="#f7f3ff" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="5"
            Padding="15">

        

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row: Title and Days Ago -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="{Binding Title}"
                          FontSize="16" 
                          FontWeight="SemiBold"
                          Foreground="#212121"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" 
                          Text="{Binding DaysAgo}"
                          FontSize="12" 
                          Foreground="#757575"
                          VerticalAlignment="Center"/>
            </Grid>

            <!-- Due Date Row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Due date: " 
                          FontSize="12" 
                          Foreground="#757575"/>
                <TextBlock Text="{Binding DueDate}" 
                          FontSize="12" 
                          FontWeight="Medium"
                          Foreground="#424242"/>
            </StackPanel>

            <!-- Bottom Row: Priority and Status -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Priority Section -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" 
                            Style="{StaticResource PriorityEllipseStyle}"
                            Margin="0,0,8,0"/>
                    <TextBlock Text="Priority: " 
                              FontSize="12" 
                              Foreground="#424242"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Priority}" 
                              FontSize="12" 
                              FontWeight="Medium"
                              Foreground="#424242"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" 
                       Style="{StaticResource StatusBorderStyle}"
                       CornerRadius="12" 
                       Padding="12,4">
                    <TextBlock Text="{Binding Status}" 
                              FontSize="12" 
                              FontWeight="Medium"
                              Foreground="White"
                              HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
