<UserControl x:Class="TodoList_Project.Features.Categories.Views.CategoryCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Categories.Views"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="270">
    <UserControl.Resources>
        <Style x:Key="CategoryProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="8" />
            <Setter Property="Foreground"
                    Value="{Binding CategoryBrush}" />
            <Setter Property="Background"
                    Value="{Binding ProgressBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="4"
                                           RadiusY="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Background="{Binding CardBackgroundBrush}"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding EditCommand}"
                          CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.12"
                              BlurRadius="12"
                              ShadowDepth="1"
                              Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border Grid.Column="0"
                        Background="{Binding IconBackgroundBrush}"
                        CornerRadius="8"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center">
                    <fa:IconImage Icon="{Binding IconName}"
                                  Height="16"
                                  Width="16"
                                  Foreground="{Binding CategoryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Category Title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CategoryName}"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="{Binding CategoryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <!-- Stats Section -->
            <StackPanel Grid.Row="1">
                <!-- Total Tasks -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Total Tasks:"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Foreground="{Binding CategoryTextBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalTasks}"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               FontWeight="Medium"
                               Foreground="{Binding CategoryTextBrush}" />
                </Grid>

                <!-- Completed Tasks -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Completed:"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="{Binding CategoryTextBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding CompletedTasks}"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               FontWeight="Medium"
                               Foreground="#10B981" />
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercentage}"
                             Maximum="100"
                             Loaded="ProgressBar_Loaded"
                             Style="{StaticResource CategoryProgressBar}"
                             Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>