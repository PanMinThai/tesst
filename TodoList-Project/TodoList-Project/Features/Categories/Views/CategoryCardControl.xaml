<UserControl x:Class="TodoList_Project.Features.Categories.Views.CategoryCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Categories.Views"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Features/Categories/Views/CategoryCardControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>

    <Border Background="{Binding CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderBrush="{Binding CardBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Cursor="Hand">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.1"
                              BlurRadius="15"
                              ShadowDepth="2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Border Grid.Column="0"
                        Background="{Binding IconBackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CornerRadius="8"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{Binding CategoryBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Category Title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CategoryName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{Binding CategoryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <!-- Stats Section -->
            <StackPanel Grid.Row="1">
                <!-- Total Tasks -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Total Tasks:"
                               FontSize="12"
                               Foreground="{Binding CategoryLightTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalTasks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{Binding CategoryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>

                <!-- Completed Tasks -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Completed:"
                               FontSize="12"
                               Foreground="{Binding CategoryLightTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding CompletedTasks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#10B981" />
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercentage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Maximum="100"
                             Style="{StaticResource CategoryProgressBar}"
                             Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>