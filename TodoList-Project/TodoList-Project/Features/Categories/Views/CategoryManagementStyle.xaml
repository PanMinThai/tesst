<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334A90E2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                                         Value="True">
                                <Setter Property="Background" Value="#4A90E2" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Different border colors for different positions -->
        <Style x:Key="TodayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush" Value="#4A90E2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334A90E2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="YesterdayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush"
                    Value="#50C878" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3350C878" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThisWeekButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush" Value="#FFB347" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFB347" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LastWeekButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush"
                    Value="#FF6B6B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF6B6B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThisMonthButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush" Value="#9B59B6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#339B59B6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LastMonthButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="BorderBrush" Value="#E67E22" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33E67E22" />
                </Trigger>
            </Style.Triggers>
        </Style>

</ResourceDictionary>