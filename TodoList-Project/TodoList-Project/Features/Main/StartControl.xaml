<UserControl x:Class="TodoList_Project.Features.Main.StartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Main"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1018">
    <UserControl.Resources>
        <Style x:Key="PaginationButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#f0f0f0" />
            <Setter Property="Foreground"
                    Value="#333333" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="Margin"
                    Value="5,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Border CornerRadius="12" Padding ="10" Background="#2a156f">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Stats Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7950fd" Offset="0"/>
                            <GradientStop Color="#78a2fc" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36*"/>
                                <RowDefinition Height="17*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.RowSpan="2">
                                <fa:IconImage Icon="ArrowTrendUp" Foreground="White" Width="30" Height="30" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="InProgress" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding InProgressCount, StringFormat={}{0} Tasks}"  Foreground="White" FontSize="18" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#78a3fc" Offset="0"/>
                            <GradientStop Color="#4bd9ec" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Check" Foreground="White" Width="30" Height="30" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Completed" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CompletedCount, StringFormat={}{0} Tasks}"  Foreground="White" FontSize="18" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#fb569c" Offset="0"/>
                            <GradientStop Color="#fba0aa" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RectangleXmark" Foreground="White" Width="30" Height="30" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Cancelled" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CancelledCount, StringFormat={}{0} Tasks}"  Foreground="White" FontSize="18" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Stat Card 4 -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" >
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A855F7" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RectangleXmark"
                                              Foreground="White"
                                              Width="30"
                                              Height="30"
                                              Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="OverDue"
                                               Foreground="White"
                                               FontSize="28"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding CancelledCount, StringFormat={}{0} Tasks}"
                                               Foreground="White"
                                               FontSize="18" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Contents Row -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Grid.Row="1" Margin="10,0">

                <!-- Today Button with notification count -->
                <Button Content="Today"
                        Command="{Binding ShowTodayTasksCommand}" />

                <!-- This Week Button with notification count -->
                <Button Content="This Week"
                        Command="{Binding ShowThisWeekTasksCommand}" />

                <!-- All Button with notification count -->
                <Button Content="All"
                        Command="{Binding ShowAllTasksCommand}" />

            </StackPanel>
            <!-- Contents Row -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Tasks Today -->
                <Border Grid.Column="0"
                        Background="#ffffff"
                        CornerRadius="12"
                        Padding="10"
                        Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="In Progress Tasks"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        FlowDirection="RightToLeft">
                                <Border Background="LightBlue"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" >
                                    <Button Background="Transparent"
                                            Command="{Binding NextPageCommand}">
                                        <fa:IconImage Icon="AngleRight"
                                                      Height="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    </Button>
                                    
                                </Border>
                                <Border Background="LightBlue"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                    <Button Background="Transparent"
                                            Command="{Binding PreviousPageCommand}">
                                        <fa:IconImage Icon="AngleLeft"
                                                      Height="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Tasks Grid -->
                        <Grid IsSharedSizeScope="True" Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Tasks}"
                                          VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"
                                                     Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Viewbox Stretch="Uniform">
                                            <local:TaskItemControl Margin="10" />
                                        </Viewbox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Pagination -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0">

                            <TextBlock Margin="10,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Page {0} of {1}">
                                        <Binding Path="CurrentPage" />
                                        <Binding Path="TotalPages" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- Last Tasks -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                </Grid>
            </Grid>


        </Grid>
    </Border>
</UserControl>
