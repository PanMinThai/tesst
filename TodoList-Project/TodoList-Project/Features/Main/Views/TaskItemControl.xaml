<UserControl x:Class="TodoList_Project.Features.Main.TaskItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Main"
             mc:Ignorable="d"
             d:DesignHeight="120" 
             d:DesignWidth="280"
             MaxHeight="120"
             MinWidth="260"
             Background="Transparent">

    <Border BorderBrush="{Binding BorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="5" Padding="10"
        Background="{Binding BackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Title and Delete Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="13"   
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"/>

                <!-- Delete Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource CancelTaskButtonStyle}"
                        Command="{Binding CancelTaskCommand}"
                        VerticalAlignment="Center"
                        Width="20"
                        Height="20" /> 
            </Grid>

            <!-- Row 1: DaysAgo -->
            <TextBlock Grid.Row="1"
                       Text="{Binding DaysAgo}"
                       FontSize="12"       
                       FontWeight="Medium"
                       Foreground="{Binding TimeTextColor}"
                       Margin="0,4,0,0" />    

            <!-- Row 2: Due Date -->
            <TextBlock Grid.Row="2"
                       Text="{Binding DueDate, StringFormat='Due: {0}'}"
                       FontSize="12"        
                       Foreground="#6B7280"
                       Margin="0,4,0,0" />  

            <!-- Row 3: Priority and Checkbox -->
            <Grid Grid.Row="3"
                    Margin="0,6,0,0">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Priority Badge -->
                <Border Grid.Column="0"
                        Background="{Binding PriorityBackground}"
                        CornerRadius="4"
                        Padding="6,2" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Priority}"
                               FontSize="12" 
                               FontWeight="Medium"
                               Foreground="{Binding PriorityTextColor}" />
                </Border>

                <!-- Checkbox -->
                <CheckBox Grid.Column="2"
                          Style="{StaticResource TaskCheckBoxStyle}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                          Width="20"
                          Height="20" /> 
            </Grid>
        </Grid>
    </Border>
</UserControl>