<UserControl x:Class="TodoList_Project.Features.Tasks.Views.AddTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Tasks.Views"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converter="clr-namespace:TodoList_Project.Core.Utils.Converters"
             mc:Ignorable="d"
             Height="650"
             Width="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AddTaskControlStyle.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Amber" SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
            <converter:PriorityLevelConverter x:Key="PriorityLevelConverter" />
        </ResourceDictionary>
        
    </UserControl.Resources>
    
    <Border Style="{StaticResource MainBorderStyle}">
        <StackPanel Margin="10">

            <!-- Task Title Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="PenNib"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#60a5fa" />
                    <TextBlock Text="Task Title"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <TextBox x:Name="TaskTitleTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Due Date Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="CalendarDay"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#4ade80" />
                    <TextBlock Text="Due Date"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <DatePicker x:Name="DueDatePicker"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding DueDate}" />
            </StackPanel>

            <!-- Priority Level Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="Fire"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#FF0000" />
                    <TextBlock Text="Priority Level"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>

                <!-- Star Rating -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <TextBlock Text="Rate priority:"
                               Style="{StaticResource SubTextStyle}"
                               Margin="0,0,15,0" />
                    <materialDesign:RatingBar x:Name="BasicRatingBar"
                                              Value="2"
                                              Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Text="{Binding ElementName=BasicRatingBar, Path=Value, Converter={StaticResource PriorityLevelConverter}}"
                               Style="{StaticResource SubTextStyle}"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- Priority Options -->
        
            </StackPanel>

            <!-- Categories Section -->
            <StackPanel Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <TextBlock Text="🏷️"
                               FontSize="16"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Categories"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>

                <WrapPanel>
                    
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#818cf8">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💼"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Work"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#4ade80"
                                  IsChecked="True">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Personal"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#f472b6">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💖"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Health"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#818cf8"
                                  IsChecked="True">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎓"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Education"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#facc15">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💲"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Finance"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#60a5fa"
                                  IsChecked="True">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Shopping"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                     <!--Row 2--> 
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#c084fc">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✈️"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Travel"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Tag="#f87171">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮"
                                           FontSize="16"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Hobbies"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#e5e7eb" />
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                </WrapPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Width="200"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="✕ Cancel"
                        HorizontalAlignment="Left"
                        Margin="0,0,15,0"
                        Command="{Binding CloseCommand}" />
                <Button x:Name="CreateTaskButton"
                        Width="200"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="➕ Create Task"
                        Command="{Binding AddTaskCommand}" />
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
