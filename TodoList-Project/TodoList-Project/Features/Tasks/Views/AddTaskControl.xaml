<UserControl x:Class="TodoList_Project.Features.Tasks.Views.AddTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Tasks.Views"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d"
             Height="700"
             Width="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AddTaskControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource MainBorderStyle}">
        <StackPanel Margin="10">

            <!-- Task Title Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="PenNib"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#60a5fa" />
                    <TextBlock Text="Task Title"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <TextBox x:Name="TaskTitleTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="Enter your task title..." />
            </StackPanel>

            <!-- Due Date Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="CalendarDay"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#4ade80" />
                    <TextBlock Text="Due Date"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>
                <DatePicker x:Name="DueDatePicker"
                            Style="{StaticResource ModernDatePickerStyle}" />
            </StackPanel>

            <!-- Priority Level Section -->
            <StackPanel Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <fa:IconImage Icon="Fire"
                                  Style="{StaticResource TitleIcon}"
                                  Foreground="#FF0000" />
                    <TextBlock Text="Priority Level"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>

                <!-- Star Rating -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <TextBlock Text="Rate priority:"
                               Style="{StaticResource SubTextStyle}"
                               Margin="0,0,15,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource StarButtonStyle}"
                                Content="⭐"
                                Tag="1" />
                        <Button Style="{StaticResource StarButtonStyle}"
                                Content="⭐"
                                Tag="2" />
                        <Button Style="{StaticResource StarButtonStyle}"
                                Content="⭐"
                                Tag="3" />
                        <Button Style="{StaticResource StarButtonStyle}"
                                Content="⭐"
                                Tag="4" />
                        <Button Style="{StaticResource StarButtonStyle}"
                                Content="☆"
                                Tag="5" />
                    </StackPanel>
                    <TextBlock Text="High"
                               Style="{StaticResource SubTextStyle}"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- Priority Options -->
                <StackPanel>
                    <TextBlock Text="Or select from options:"
                               Style="{StaticResource SubTextStyle}"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LowPriority"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Content="Low" />
                        <RadioButton x:Name="MediumPriority"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Content="Medium"
                                     IsChecked="True" />
                        <RadioButton x:Name="HighPriority"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Content="High" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Categories Section -->
            <StackPanel Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <TextBlock Text="🏷️"
                               FontSize="16"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Categories"
                               Style="{StaticResource SectionHeaderStyle}" />
                </StackPanel>

                <WrapPanel>
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="💼 Work" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="👤 Personal" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="💙 Health" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="🎓 Education" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="💰 Finance" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="🛒 Shopping" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="✈️ Travel" />
                    <ToggleButton Style="{StaticResource CategoryButtonStyle}"
                                  Content="🎯 Entertainment" />
                </WrapPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="✕ Cancel"
                        Margin="0,0,15,0" />
                <Button x:Name="SaveDraftButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="📄 Save Draft"
                        Margin="0,0,15,0" />
                <Button x:Name="CreateTaskButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="➕ Create Task" />
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
