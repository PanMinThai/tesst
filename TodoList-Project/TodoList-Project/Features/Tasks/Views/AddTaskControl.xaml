<UserControl x:Class="TodoList_Project.Features.Tasks.Views.AddTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TodoList_Project.Features.Tasks.Views"
             mc:Ignorable="d"
             Width="800"
             Height="450">
    <UserControl.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#1a1b3a"
                          Offset="0" />
            <GradientStop Color="#2d1b69"
                          Offset="0.5" />
            <GradientStop Color="#1a1b3a"
                          Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#2a2d5f"
                          Offset="0" />
            <GradientStop Color="#1e2147"
                          Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonPrimaryGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#667eea"
                          Offset="0" />
            <GradientStop Color="#764ba2"
                          Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonDangerGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#ff6b6b"
                          Offset="0" />
            <GradientStop Color="#ee5a24"
                          Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonSecondaryGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#4c5270"
                          Offset="0" />
            <GradientStop Color="#3c4158"
                          Offset="1" />
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="ModernTextBox"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#1e2147" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#4a4d70" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12,10" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#667eea" />
                                <Setter Property="Background"
                                        Value="#252852" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Height"
                    Value="45" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                x:Name="ButtonBorder">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="#4a4d70" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                x:Name="ButtonBorder">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#667eea" />
                    <Setter Property="BorderBrush"
                            Value="#667eea" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PriorityRadioButton"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="16"
                                     Height="16"
                                     Fill="{TemplateBinding Tag}"
                                     Stroke="#4a4d70"
                                     StrokeThickness="2"
                                     x:Name="RadioCircle" />
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="RadioCircle"
                                        Property="Stroke"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                                <Setter TargetName="RadioCircle"
                                        Property="StrokeThickness"
                                        Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container -->
    <Border Background="{StaticResource BackgroundGradient}"
            CornerRadius="16"
            x:Name="MainBorder">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.3" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,24">
                <TextBlock Text="New Task"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />

                <Button Content="✕"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8892b0"
                        FontSize="16"
                        Cursor="Hand"
                        x:Name="CloseButton" />
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <StackPanel >

                    <!-- Task Title -->
                    <StackPanel>
                        <TextBlock Text="Task Title"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#8892b0"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="TaskTitleTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="Làm bài tập lập trình"/>
                    </StackPanel>

                    <!-- Categories -->
                    <StackPanel>
                        <TextBlock Text="Category"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#8892b0"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal"
                                    x:Name="CategoryPanel">
                            <Button Content="Meeting"
                                    Style="{StaticResource CategoryButton}"
                                    Margin="0,0,8,0" />
                            <Button Content="Design"
                                    Style="{StaticResource CategoryButton}"
                                    Background="#667eea"
                                    BorderBrush="#667eea"
                                    Margin="0,0,8,0" />
                            <Button Content="Planner"
                                    Style="{StaticResource CategoryButton}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Priority -->
                    <StackPanel>
                        <TextBlock Text="Priority"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#8892b0"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal"
                                    x:Name="PriorityPanel">
                            <RadioButton Content="High"
                                         Style="{StaticResource PriorityRadioButton}"
                                         Tag="#ff6b6b"
                                         Margin="0,0,24,0"
                                         x:Name="HighPriorityRadio" />
                            <RadioButton Content="Medium"
                                         Style="{StaticResource PriorityRadioButton}"
                                         Tag="#ffa726"
                                         IsChecked="True"
                                         Margin="0,0,24,0"
                                         x:Name="MediumPriorityRadio" />
                            <RadioButton Content="Low"
                                         Style="{StaticResource PriorityRadioButton}"
                                         Tag="#66bb6a"
                                         x:Name="LowPriorityRadio" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Due Date -->
                    <StackPanel>
                        <TextBlock Text="Due Date"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#8892b0"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="6/29/2025"
                                     x:Name="DueDateTextBox" />
                            <TextBlock Text="📅"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Opacity="0.7" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <Grid Grid.Row="2"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Create Task"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource ButtonPrimaryGradient}"
                        x:Name="CreateButton" />

                <Button Grid.Column="4"
                        Content="Cancel"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource ButtonSecondaryGradient}"
                        x:Name="CancelButton" />
            </Grid>

        </Grid>
    </Border>
</UserControl>
