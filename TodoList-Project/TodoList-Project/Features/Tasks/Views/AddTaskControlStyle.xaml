<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="BackgroundGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#1a1b3a"
                      Offset="0" />
        <GradientStop Color="#2d1b69"
                      Offset="0.5" />
        <GradientStop Color="#1a1b3a"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#2a2d5f"
                      Offset="0" />
        <GradientStop Color="#1e2147"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonPrimaryGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#667eea"
                      Offset="0" />
        <GradientStop Color="#764ba2"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonDangerGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#ff6b6b"
                      Offset="0" />
        <GradientStop Color="#ee5a24"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonSecondaryGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#4c5270"
                      Offset="0" />
        <GradientStop Color="#3c4158"
                      Offset="1" />
    </LinearGradientBrush>

    <!-- TextBox Style -->
    <Style x:Key="ModernTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="#1e2147" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="#4a4d70" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12,10" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="#667eea" />
                            <Setter Property="Background"
                                    Value="#252852" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Style -->
    <Style x:Key="ModernButton"
           TargetType="Button">
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Height"
                Value="45" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            x:Name="ButtonBorder">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category Button Style -->
    <Style x:Key="CategoryButton"
           TargetType="Button">
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="Medium" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Padding"
                Value="16,0" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="#4a4d70" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            x:Name="ButtonBorder">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#667eea" />
                <Setter Property="BorderBrush"
                        Value="#667eea" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Priority RadioButton Style -->
    <Style x:Key="PriorityRadioButton"
           TargetType="RadioButton">
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="Medium" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="16"
                                 Height="16"
                                 Fill="{TemplateBinding Tag}"
                                 Stroke="#4a4d70"
                                 StrokeThickness="2"
                                 x:Name="RadioCircle" />
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="RadioCircle"
                                    Property="Stroke"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                            <Setter TargetName="RadioCircle"
                                    Property="StrokeThickness"
                                    Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>