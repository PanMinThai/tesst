<Window x:Class="TodoList_Project.Features.Tasks.Views.PopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoList_Project.Features.Tasks.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" 
        mc:Ignorable="d"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="PopupView" Height="450" Width="800">
    <Border BorderThickness="1" CornerRadius="10" Background="#1c0e49">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color = "#6D2FFF" Offset="0"/>
                <GradientStop Color = "#FB539B" Offset="0.5"/>
                <GradientStop Color = "#836EFB" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"  Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="btnClose"
             Style="{DynamicResource controlButton}"
             Tag="{DynamicResource color4}"
             Click="btnClose_Click">
                    <fa:IconImage Icon="Xmark" Style="{DynamicResource controlButtonIcon}"/>
                </Button>
            </StackPanel>
            <Grid Grid.Row="1">
                <ContentControl x:Name="contentControl"/>
            </Grid>
        </Grid>
    </Border>
</Window>
