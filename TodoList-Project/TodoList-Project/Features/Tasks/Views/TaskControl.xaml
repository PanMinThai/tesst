<UserControl x:Class="TodoList_Project.Features.Tasks.Views.TaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TodoList_Project.Features.Tasks.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" xmlns:converter="clr-namespace:TodoList_Project.Core.Utils.Converters"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:EditModeToTextConverter x:Key="EditModeToTextConverter"/>
    </UserControl.Resources>
    <Border CornerRadius="12" Background="#200F53" Margin="10,0,10,0">
        <Grid Margin="10" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="New Task" 
                FontSize="20" 
                FontWeight="Bold" 
                Foreground="#BCBEE0"
                HorizontalAlignment="Left"/>
            
            </Grid>

            <!-- Task Title Input -->
            <TextBox Grid.Row="1" 
                      Name="TaskTitleTextBox"
                      Text="{Binding CurrentTask.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      FontSize="16"
                      Foreground="#BCBEE0"
                      Background="#2e1579"
                      BorderThickness="0"
                      Padding="15"
                      Height="50"
                      Margin="0,0,0,10">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Category Buttons -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                <Button Name="MeetingBtn" Content="Meeting" Style="{StaticResource SelectedCategoryButtonStyle}"/>
                <Button Name="DesignBtn" Content="Design" Style="{StaticResource UnselectedCategoryButtonStyle}"/>
                <Button Name="PlannerBtn" Content="Planner" Style="{StaticResource UnselectedCategoryButtonStyle}" />

            </WrapPanel>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Priority" FontSize="16" FontWeight="Medium" Foreground="#999" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Name="HighPriorityRb"
                                     Content="High" 
                                     GroupName="Priority"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Foreground="#FF4444"
                                     Margin="30,0,30,0"
                                     IsChecked="{Binding CurrentTask.IsHighPriority, Mode=TwoWay}"/>
                        <RadioButton Name="MediumPriorityRb" 
                                     Content="Medium" 
                                     GroupName="Priority"
                                     IsChecked="{Binding CurrentTask.IsMediumPriority, Mode=TwoWay}"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Foreground="#FF9800"
                                     Margin="0,0,30,0"/>
                        <RadioButton Name="LowPriorityRb" 
                                     Content="Low" 
                                     GroupName="Priority"
                                     Style="{StaticResource PriorityRadioButtonStyle}"
                                     Foreground="#4CAF50"
                                     IsChecked="{Binding CurrentTask.IsLowPriority, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1">
                    <DatePicker Margin="5" Width="120" Height="50" Style="{StaticResource MaterialDesignFilledDatePicker}" SelectedDate="{Binding CurrentTask.DueDate, Mode=TwoWay}"/>
                </Grid>

            </Grid>
            <Grid Grid.Row="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" materialDesign:ButtonAssist.CornerRadius="10" Command="{Binding SaveCommand}" Content="{Binding IsEditMode, Converter={StaticResource EditModeToTextConverter}}" Margin="10,0,10,0"/>
                <Button Grid.Column="1" materialDesign:ButtonAssist.CornerRadius="10" Command="{Binding DeleteCommand}" Content="Delete" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="10,0,10,0"/>
                <Button Grid.Column="2" materialDesign:ButtonAssist.CornerRadius="10" Command="{Binding CancelCommand}" Content="Cancel" Margin="10,0,10,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
