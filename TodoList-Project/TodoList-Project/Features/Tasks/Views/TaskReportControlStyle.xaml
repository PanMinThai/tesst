<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--Background Colors-->
    <SolidColorBrush x:Key="backgroundColor1" Color="#1a0c47" />
    <SolidColorBrush x:Key="backgroundColor2" Color="#200f53" />
    <LinearGradientBrush x:Key="PieItem1Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7950fd" Offset="0" />
        <GradientStop Color="#FF78a2fc" Offset="1" />
    </LinearGradientBrush>

    <!-- Gradient cho item 2: #78a3fc -> #4bd9ec -->
    <LinearGradientBrush x:Key="PieItem2Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF78a3fc" Offset="0" />
        <GradientStop Color="#FF4bd9ec" Offset="1" />
    </LinearGradientBrush>

    <!-- Gradient cho item 3: #A855F7 -> #EC4899 -->
    <LinearGradientBrush x:Key="PieItem3Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA855F7" Offset="0" />
        <GradientStop Color="#FFEC4899" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>