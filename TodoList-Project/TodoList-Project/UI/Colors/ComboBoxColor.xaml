<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBackgroundBrush"
                     Color="#1A0D2E" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush"
                     Color="#16213E" />
    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="#0F3460" />

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PurpleAccentBrush"
                     Color="#533483" />
    <SolidColorBrush x:Key="BlueAccentBrush"
                     Color="#16537e" />
    <SolidColorBrush x:Key="PinkAccentBrush"
                     Color="#E43C7E" />
    <SolidColorBrush x:Key="OrangeAccentBrush"
                     Color="#F79256" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#B0B3B8" />
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#8B8FA8" />

    <!-- Border Colors -->
    <SolidColorBrush x:Key="PrimaryBorderBrush"
                     Color="#2D1B69" />
    <SolidColorBrush x:Key="HoverBorderBrush"
                     Color="#4A3490" />
    <SolidColorBrush x:Key="FocusBorderBrush"
                     Color="#6A4C93" />

    <!-- Interactive States -->
    <SolidColorBrush x:Key="HoverBackgroundBrush"
                     Color="#1E1A3A" />
    <SolidColorBrush x:Key="ActiveBackgroundBrush"
                     Color="#2A2055" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush"
                     Color="#3D2F73" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#533483"
                      Offset="0" />
        <GradientStop Color="#16537e"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#1A0D2E"
                      Offset="0" />
        <GradientStop Color="#16213E"
                      Offset="0.5" />
        <GradientStop Color="#0F3460"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ComboBoxGradientBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#2A1B55"
                      Offset="0" />
        <GradientStop Color="#1A0D3A"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ComboBoxHoverGradientBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#3D2F73"
                      Offset="0" />
        <GradientStop Color="#2A1B55"
                      Offset="1" />
    </LinearGradientBrush>

    <!-- Success, Warning, Error Colors -->
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#4CAF50" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="#FF9800" />
    <SolidColorBrush x:Key="ErrorBrush"
                     Color="#F44336" />

    <!-- Shadow Colors -->
    <Color x:Key="ShadowColor">#1A0D2E</Color>
    <Color x:Key="GlowColor">#533483</Color>
</ResourceDictionary>